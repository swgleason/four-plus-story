# Four Plus Story Library API — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
APP_ENV=development
DEBUG=false

# ---------------------------------------------------------
# Supabase
# ---------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Use the server-only service role/secret key from this same Supabase project.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
RAW_DOCUMENTS_BUCKET=raw-documents
MAX_DOCUMENT_UPLOAD_BYTES=25000000
DOCUMENT_CHUNK_MAX_TOKENS=800
DOCUMENT_CHUNK_OVERLAP_TOKENS=100

# ---------------------------------------------------------
# AI Provider Selection
# Primary provider: anthropic | openai | gemini | mock
# Use "mock" in development to avoid needing API keys.
# ---------------------------------------------------------
AI_PRIMARY_PROVIDER=mock

# Comma-separated fallback order. Example: openai,mock
AI_FALLBACK_PROVIDERS=mock

# ---------------------------------------------------------
# API Keys (leave blank for unused providers)
# ---------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------
# Model Names (change without code modifications)
# ---------------------------------------------------------
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o-2024-11-20
GEMINI_MODEL=gemini-1.5-pro-002

# ---------------------------------------------------------
# AI Request Defaults
# ---------------------------------------------------------
AI_TEMPERATURE=0.0
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=60.0

# ---------------------------------------------------------
# Retry & Backoff
# ---------------------------------------------------------
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY_SECONDS=1.0
AI_RETRY_MAX_DELAY_SECONDS=30.0
AI_RETRY_JITTER=true

# ---------------------------------------------------------
# Embeddings
# ---------------------------------------------------------
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_MODEL_VERSION=
